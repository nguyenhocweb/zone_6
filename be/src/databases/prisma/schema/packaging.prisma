model Packaging {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String?  @map("store_id") @db.ObjectId
  name            String   @map("name")
  code            String   @unique @map("code")
  unit            String   @map("unit") // "Cái", "Cây", "Thùng", "Lốc", "Ly"
  costPerUnit     Float    @default(0) @map("cost_per_unit")
  quantityInStock Float    @default(0) @map("quantity_in_stock")
  minThreshold    Float    @default(10) @map("min_threshold")
  temperatureMode String?  @default("both") @map("temperature_mode") // "cold" (ly lạnh) | "hot" (ly nóng) | "both" (đa năng)
  cupSize         String?  @map("cup_size") // "Size S (350ml)", "Size M (500ml)", "Size L (700ml)", "1000ml" hoặc gõ tự do
  description     String?  @map("description")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("packagings")
}
