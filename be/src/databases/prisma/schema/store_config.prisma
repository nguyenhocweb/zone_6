model StoreConfig {
  id                          String   @id @default(auto()) @map("_id") @db.ObjectId
  storeName                   String   @unique @map("store_name")
  storeCode                   String?  @unique @map("store_code")
  address                     String
  phone                       String?  @map("phone")
  imageUrl                    String?  @map("image_url")
  latitude                    Float
  longitude                   Float
  geofenceRadiusMeters        Float    @default(100) @map("geofence_radius_meters")
  allowedCheckinBeforeMinutes Int      @default(30) @map("allowed_checkin_before_minutes")
  allowedCheckinAfterMinutes  Int      @default(30) @map("allowed_checkin_after_minutes")
  isGeofenceRequired          Boolean      @default(true) @map("is_geofence_required")
  isTimeWindowStrict          Boolean      @default(true) @map("is_time_window_strict")
  orderingMode                OrderingMode @default(HYBRID) @map("ordering_mode")
  tableGeofenceRadiusMeters   Float        @default(30) @map("table_geofence_radius_meters")
  isTableGeofenceStrict       Boolean      @default(true) @map("is_table_geofence_strict")
  vatEnabled                  Boolean      @default(false) @map("vat_enabled")
  vatRate                     Float        @default(8) @map("vat_rate")
  vatApplyMode                String       @default("ALL") @map("vat_apply_mode")
  vatAppliedShifts            String[]     @default([]) @map("vat_applied_shifts")
  isActive                    Boolean      @default(true) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("store_configs")
}
