model StoreReview {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String   @map("store_id") @db.ObjectId
  storeName       String   @map("store_name")
  reviewerName    String   @map("reviewer_name")
  emailMasked     String   @map("email_masked")
  canonicalEmail  String   @map("canonical_email")
  rating          Int
  tags            String[] @default([])
  comment         String
  images          String[] @default([])
  status          String   @default("PUBLISHED")
  hiddenReason    String?  @map("hidden_reason")
  ownerReply      String?  @map("owner_reply")
  repliedById     String?  @map("replied_by_id") @db.ObjectId
  repliedByName   String?  @map("replied_by_name")
  repliedAt       DateTime? @map("replied_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([storeId, canonicalEmail])
  @@index([storeId, status, createdAt])
  @@map("store_reviews")
}
