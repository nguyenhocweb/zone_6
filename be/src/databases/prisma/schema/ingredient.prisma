model Ingredient {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String?  @map("store_id") @db.ObjectId
  name            String   @map("name")
  code            String   @unique @map("code")
  unit            String   @map("unit") // "Kg", "g", "Lít", "ml", "Hộp", "Bao", "Can"
  costPerUnit     Float    @default(0) @map("cost_per_unit")
  quantityInStock Float    @default(0) @map("quantity_in_stock")
  minThreshold    Float    @default(10) @map("min_threshold")
  usageScope      String?  @default("both") @map("usage_scope") // "customer_product" (pha chế món) | "internal_prep" (pha chế nội bộ) | "both" (áp dụng cả 2)
  description     String?  @map("description")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ingredients")
}
