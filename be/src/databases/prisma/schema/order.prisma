model Order {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  storeId        String        @map("store_id") @db.ObjectId
  shiftId        String?       @map("shift_id") @db.ObjectId
  orderCode      String        @unique @map("order_code")
  tableId        String?       @map("table_id") @db.ObjectId
  tableNumber    String?       @map("table_number")
  customerName   String?       @map("customer_name")
  customerPhone  String?       @map("customer_phone")
  deviceId       String?       @map("device_id")
  deviceName     String?       @map("device_name")
  orderSource    OrderSource   @default(STAFF_POS) @map("order_source")
  
  customerLat    Float?        @map("customer_lat")
  customerLng    Float?        @map("customer_lng")
  distanceMeters Float?        @map("distance_meters")
  
  items          Json          // Mảng các món: [{ recipeId, name, quantity, unitPrice, subtotal, toppings: [], notes, addedByName }]
  totalAmount    Float         @map("total_amount")
  discountAmount Float         @default(0) @map("discount_amount")
  vatRate        Float         @default(0) @map("vat_rate")
  vatAmount      Float         @default(0) @map("vat_amount")
  finalAmount    Float         @map("final_amount")
  
  paymentMethod  PaymentMethod @default(VIETQR) @map("payment_method")
  paymentStatus  PaymentStatus @default(COMPLETED) @map("payment_status")
  
  createdById    String?       @map("created_by_id") @db.ObjectId
  createdByName  String        @map("created_by_name")
  paidById       String?       @map("paid_by_id") @db.ObjectId
  paidByName     String?       @map("paid_by_name")
  
  voidReason     String?       @map("void_reason")
  voidedById     String?       @map("voided_by_id") @db.ObjectId
  voidedByName   String?       @map("voided_by_name")
  voidedAt       DateTime?     @map("voided_at")
  
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([storeId, createdAt])
  @@map("orders")
}

