model Material {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String?  @map("store_id") @db.ObjectId
  name            String   @map("name")
  code            String   @unique @map("code")
  category        String   @map("category") // "packaging" (ly nhựa, nắp, ống hút) | "ingredient" (trà, cà phê, đường, sữa) | "topping"
  unit            String   @map("unit") // "ly", "cái", "kg", "g", "lít", "ml", "hộp", "chai"
  costPerUnit     Float    @default(0) @map("cost_per_unit")
  quantityInStock Float    @default(0) @map("quantity_in_stock")
  minThreshold    Float    @default(10) @map("min_threshold")
  temperatureMode String?  @default("both") @map("temperature_mode") // "cold" | "hot" | "both"
  description     String?  @map("description")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("materials")
}
