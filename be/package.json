{
  "name": "zone6-zalo-be",
  "version": "1.0.0",
  "type": "module",
  "description": "Zalo Personal Bridge Service with QR Login, Session Vault, and WebSocket Listener",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate --schema=src/databases/prisma/schema",
    "build": "prisma generate --schema=src/databases/prisma/schema && tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "db:push": "prisma db push --schema=src/databases/prisma/schema",
    "db:generate": "prisma generate --schema=src/databases/prisma/schema",
    "db:seed": "tsx src/databases/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "image-size": "^2.0.4",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "socket.io": "^4.8.4",
    "zca-js": "^2.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
